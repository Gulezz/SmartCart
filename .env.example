# ══════════════════════════════════════════════════════════════
# SmartCart — environment variables
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# See SETUP_CHECKLIST.md for step-by-step instructions.
# ══════════════════════════════════════════════════════════════

# ── [APP] ─────────────────────────────────────────────────────
# Full public URL — no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── [DATABASE] ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartcart

# ── [AUTH] ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── [TRANSACTIONAL EMAIL] ─────────────────────────────────────
# Used for list invitations. Without this, emails log to the dev console.
EMAIL_FROM=SmartCart <noreply@yourdomain.com>
RESEND_API_KEY=re_...

# ── [ANTHROPIC] ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Keep the model configurable; do not hard-code it throughout the app.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── [MAPS & ROUTING] ──────────────────────────────────────────
# Server-side driving, cycling and walking routes.
OPENROUTESERVICE_API_KEY=
# The demo uses OSM's standard tiles. Select a production tile provider before launch.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# ── [RETAIL PRICE DATA] ───────────────────────────────────────
# demo = bundled deterministic fixtures; database = normalised StorePrice records.
PRICE_DATA_PROVIDER=demo
# Retailer/aggregator API keys belong in provider-specific adapters and sync workers.
PRICE_SYNC_CRON_SECRET=replace_with_a_long_random_value

# ── [STRIPE] ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Local: npx stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BRONZE=price_test_...
STRIPE_PRICE_SILVER=price_test_...
STRIPE_PRICE_GOLD=price_test_...

# ── [PUSHER] ──────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ── [UPSTASH] ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── [PRODUCTION ONLY] ─────────────────────────────────────────
# Uncomment when TLS is confirmed on your domain
# HSTS_ENABLED=true
